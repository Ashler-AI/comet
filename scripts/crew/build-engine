#!/usr/bin/env bash
# Build this branch's engine (`zeron-engine`) through the local cargo policy,
# in this worktree's own target dir, and copy it out. Not the shared target:
# other worktrees build other trees' crates of the same names there, and a
# path crate built from another tree can look fresh to this one.
#
#   scripts/crew/build-engine            # -> ~/.crew-zgx-dev/bin/zeron-engine
#   CREW_ZGX_ENGINE_BIN=/path scripts/crew/build-engine
#   CREW_ZGX_TARGET_DIR=/path            # default: <worktree>/target
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
target="${CREW_ZGX_TARGET_DIR:-$root/target}"
out="${CREW_ZGX_ENGINE_BIN:-$HOME/.crew-zgx-dev/bin/zeron-engine}"
mkdir -p "$(dirname "$out")"
exec "$root/scripts/crew/clean-env" python3 "$root/scripts/local-cargo.py" \
  build -p zeron --bin zeron-engine --target-dir "$target" \
  --copy-binary debug/zeron-engine "$out"
