#!/usr/bin/env bash
# Run this branch's zgx against its own engine, isolated from every other
# Crew and Zeron on this Mac (docs/crew/zgx-thin-port.md):
#   - data ~/.crew-zgx-dev, IPC port 27960, the agents' home under it
#     (zeron_cli::crew and apps/zgx/src/engine/manager.rs decide these);
#   - the Edge and Scaffold the engine reads from ~/.crew-zgx-dev/crew-runtime.json,
#     or none (signed out, local) without it;
#   - nothing inherited from the Crew that started this shell (clean-env).
#
# ZERON_ZGX_PRIVATE_SIGNIN=1 signs in in a private Chrome window.
#
#   scripts/crew/build-engine            # once, and after engine changes
#   scripts/crew/dev-zgx [main|gallery|onboarding|intro]   (default: main)
#
# Needs Zig 0.16 for zgx's terminals (Ghostty): ZIG=/path/to/zig, or
# ~/.crew-zgx-dev/zig/zig. Builds in this worktree's own target dir
# (CREW_ZGX_TARGET_DIR, default <worktree>/target), as build-engine does.
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
zig="${ZIG:-$HOME/.crew-zgx-dev/zig/zig}"
engine="${CREW_ZGX_ENGINE_BIN:-$HOME/.crew-zgx-dev/bin/zeron-engine}"
target="${CREW_ZGX_TARGET_DIR:-$root/target}/zgx"

[[ -x "$zig" ]] || { echo "no Zig 0.16 at $zig (set ZIG)" >&2; exit 1; }
[[ -x "$engine" ]] || { echo "no engine at $engine: run scripts/crew/build-engine" >&2; exit 1; }

cd "$root/apps/zgx"
exec "$root/scripts/crew/clean-env" \
  ZIG="$zig" \
  CARGO_TARGET_DIR="$target" \
  ZERON_ZGX_ENGINE_BIN="$engine" \
  ZERON_ZGX_PRIVATE_SIGNIN="${ZERON_ZGX_PRIVATE_SIGNIN:-}" \
  ZERON_DISABLE_NOTIFICATIONS=1 \
  cargo run -- "${1:-main}"
