+    let doc = LoroDoc::new();
+    doc.set_peer_id(1).unwrap();
+    let map = doc.get_map("map");
+    map.insert("same", "same").unwrap();
+    map.insert("remove", "keep").unwrap();
+    map.insert("tombstone", "deleted").unwrap();
+    map.delete("tombstone").unwrap();
+    let child = map.insert_container("child", LoroMap::new()).unwrap();
+    child.insert("value", "child").unwrap();
+    doc.get_list("list").push(1).unwrap();
+    doc.commit();
+    doc.set_peer_id(2).unwrap();
+    map.insert("same", "intermediate").unwrap();
+    map.insert("same", "same").unwrap();
+    doc.commit();
+    assert_eq!(map.get_last_editor("same"), Some(2));
+    let before = observe(&doc);
+    let editors = ["same", "remove", "tombstone", "child", "absent"]
+        .map(|key| map.get_last_editor(key));
+    let events = Arc::new(AtomicUsize::new(0));
+    let event_count = events.clone();
+    let _events = doc.subscribe_root(Arc::new(move |_| { event_count.fetch_add(1, Ordering::SeqCst); }));
+    let updates = Arc::new(AtomicUsize::new(0));
+    let update_count = updates.clone();
+    let _updates = doc.subscribe_local_update(Box::new(move |_| {
+        update_count.fetch_add(1, Ordering::SeqCst);
+        true
+    }));
+    let mut changed = rustc_hash::FxHashMap::default();
+    changed.insert("same".into(), Some(ValueOrContainer::Value("batch-value".into())));
+    changed.insert("remove".into(), None);
+    changed.insert("tombstone".into(), Some(ValueOrContainer::Value("revived".into())));
+    changed.insert("child".into(), Some(ValueOrContainer::Value("not a child".into())));
+    changed.insert("absent".into(), Some(ValueOrContainer::Value(1.into())));
+    let mut batch = DiffBatch::default();
+    batch.push(root("map", ContainerType::Map), Diff::Map(MapDelta { updated: changed })).unwrap();
+    batch.push(root("list", ContainerType::List), Diff::List(vec![ListDiffItem::Delete { delete: 5 }])).unwrap();
+    assert!(doc.apply_diff(batch).is_err());
+    doc.commit();
+    assert_eq!(observe(&doc), before);
+    assert_eq!(["same", "remove", "tombstone", "child", "absent"].map(|key| map.get_last_editor(key)), editors);
+    assert_eq!(map.get("child").unwrap().into_container().unwrap().id(), child.id());
+    assert_eq!(events.load(Ordering::SeqCst), 0);
+    assert_eq!(updates.load(Ordering::SeqCst), 0);
+    assert_consistent_with_replay(&doc);
+}
